EXPO_PUBLIC_APP_URL=https://your-api-domain.com
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id
# Public CDN base for non-proxy event image fallbacks (optional display only).
EXPO_PUBLIC_EVENTS_INFO_SECTION_URL=https://lionsgeek.ma/
# Required: mobile events/info-session traffic must go through Sanctum proxy.
EXPO_PUBLIC_EVENTS_INFO_USE_PROXY=true
# Do NOT set EXPO_PUBLIC_EVENTS_INFO_SECTION_KEY in the mobile app — it would ship in the bundle.
# Section keys belong on the server only.
